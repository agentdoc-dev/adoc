{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.authorization_decision.v0.schema.json",
  "title": "AgentDoc Authorization Decision",
  "description": "Replayable, source-neutral authorization decision for E2.2. The record carries the explicit evaluation time, policy version, complete scoped grant input, source ACL ceiling, visibility and action-policy inputs, winning basis, and allow/deny/insufficient_context result. Schema validation pins fail-closed structural invariants and the top-level freshness precedence; the Cloud evaluator owns lower-gate precedence, grant applicability, scope matching, expiry evaluation, and replay semantics.",
  "type": "object",
  "required": [
    "schema_version",
    "principal",
    "permission",
    "resource",
    "evaluation_time",
    "consequential",
    "hard_deny",
    "grants",
    "source_acl_ceiling",
    "visibility",
    "action_policy",
    "policy_version",
    "result",
    "reason",
    "basis"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.authorization_decision.v0" },
    "principal": { "$ref": "#/$defs/principal" },
    "permission": { "$ref": "#/$defs/permission" },
    "resource": {
      "description": "Complete scope of the resource being authorized.",
      "$ref": "#/$defs/scope"
    },
    "evaluation_time": {
      "description": "Raw evaluator timestamp input. The evaluator parses this value and records evaluation_time_invalid when it is unusable; schema validation preserves the invalid input for replay.",
      "type": "string"
    },
    "consequential": { "type": "boolean" },
    "hard_deny": { "type": "boolean" },
    "grants": {
      "type": "array",
      "items": { "$ref": "#/$defs/grant" }
    },
    "source_acl_ceiling": { "$ref": "#/$defs/sourceAclCeiling" },
    "visibility": { "$ref": "#/$defs/policyInput" },
    "action_policy": { "$ref": "#/$defs/policyInput" },
    "policy_version": { "$ref": "#/$defs/nonEmpty" },
    "result": { "$ref": "#/$defs/decision" },
    "reason": {
      "description": "Evaluator outcome reason. evaluation_time_invalid is raised only after identity freshness passes; timestamp parsing itself is evaluator-owned so an invalid raw input remains recordable for replay.",
      "enum": [
        "identity_context_missing",
        "identity_expired",
        "evaluation_time_invalid",
        "hard_deny",
        "source_acl_denied",
        "source_acl_unavailable",
        "no_grant",
        "explicit_deny",
        "visibility_denied",
        "visibility_unavailable",
        "action_policy_denied",
        "action_policy_unavailable",
        "allowed"
      ]
    },
    "basis": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/basis" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "principal": {
            "properties": { "type": { "const": "human" } },
            "required": ["type"]
          }
        },
        "required": ["principal"]
      },
      "then": {
        "properties": {
          "grants": {
            "items": {
              "if": {
                "properties": { "source": { "const": "direct_grant" } },
                "required": ["source"]
              },
              "then": { "required": ["exceptional_reason"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "principal": {
            "properties": { "freshness": { "const": "expired" } },
            "required": ["freshness"]
          }
        },
        "required": ["principal"]
      },
      "then": {
        "properties": { "reason": { "const": "identity_expired" } }
      }
    },
    {
      "if": {
        "properties": {
          "principal": {
            "properties": {
              "freshness": { "const": "insufficient_context" }
            },
            "required": ["freshness"]
          }
        },
        "required": ["principal"]
      },
      "then": {
        "properties": {
          "reason": { "const": "identity_context_missing" }
        }
      }
    },
    {
      "if": {
        "properties": { "result": { "const": "allow" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "principal": {
            "properties": { "freshness": { "const": "current" } },
            "required": ["freshness"]
          },
          "hard_deny": { "const": false },
          "grants": {
            "contains": {
              "properties": { "effect": { "const": "allow" } },
              "required": ["effect"]
            }
          },
          "source_acl_ceiling": {
            "properties": {
              "result": { "enum": ["allow", "not_applicable"] }
            },
            "required": ["result"]
          },
          "visibility": { "enum": ["allow", "not_applicable"] },
          "action_policy": { "enum": ["allow", "not_applicable"] },
          "reason": { "const": "allowed" },
          "basis": {
            "allOf": [
              { "$ref": "#/$defs/basis" },
              {
                "properties": { "effect": { "const": "allow" } },
                "required": ["effect"]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "allowed" } },
        "required": ["reason"]
      },
      "then": {
        "properties": { "result": { "const": "allow" } }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "not": { "const": "evaluation_time_invalid" } }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "evaluation_time": { "$ref": "#/$defs/rfc3339Timestamp" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "identity_expired" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "principal": {
            "properties": { "freshness": { "const": "expired" } },
            "required": ["freshness"]
          },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "identity_context_missing" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "principal": {
            "properties": {
              "freshness": { "const": "insufficient_context" }
            },
            "required": ["freshness"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "consequential": { "const": true } },
              "required": ["consequential"]
            },
            "then": {
              "properties": { "result": { "const": "insufficient_context" } }
            },
            "else": {
              "properties": { "result": { "const": "deny" } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "no_grant" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "basis": { "type": "null" },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": { "const": "evaluation_time_invalid" }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "principal": {
            "properties": { "freshness": { "const": "current" } },
            "required": ["freshness"]
          },
          "basis": { "type": "null" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "consequential": { "const": true } },
              "required": ["consequential"]
            },
            "then": {
              "properties": { "result": { "const": "insufficient_context" } }
            },
            "else": {
              "properties": { "result": { "const": "deny" } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "explicit_deny" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "grants": {
            "contains": {
              "properties": { "effect": { "const": "deny" } },
              "required": ["effect"]
            }
          },
          "basis": {
            "allOf": [
              { "$ref": "#/$defs/basis" },
              {
                "properties": { "effect": { "const": "deny" } },
                "required": ["effect"]
              }
            ]
          },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "hard_deny" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "hard_deny": { "const": true },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_acl_denied" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "source_acl_ceiling": {
            "properties": { "result": { "const": "deny" } },
            "required": ["result"]
          },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "source_acl_unavailable" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "source_acl_ceiling": {
            "properties": { "result": { "const": "insufficient_context" } },
            "required": ["result"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "consequential": { "const": true } },
              "required": ["consequential"]
            },
            "then": {
              "properties": { "result": { "const": "insufficient_context" } }
            },
            "else": {
              "properties": { "result": { "const": "deny" } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "visibility_denied" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "visibility": { "const": "deny" },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "visibility_unavailable" } },
        "required": ["reason"]
      },
      "then": {
        "properties": { "visibility": { "const": "insufficient_context" } },
        "allOf": [
          {
            "if": {
              "properties": { "consequential": { "const": true } },
              "required": ["consequential"]
            },
            "then": {
              "properties": { "result": { "const": "insufficient_context" } }
            },
            "else": {
              "properties": { "result": { "const": "deny" } }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "action_policy_denied" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "action_policy": { "const": "deny" },
          "result": { "const": "deny" }
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "action_policy_unavailable" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "action_policy": { "const": "insufficient_context" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "consequential": { "const": true } },
              "required": ["consequential"]
            },
            "then": {
              "properties": { "result": { "const": "insufficient_context" } }
            },
            "else": {
              "properties": { "result": { "const": "deny" } }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "rfc3339Timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    },
    "permission": {
      "type": "string",
      "enum": [
        "audit.export",
        "audit.read",
        "connector.configure",
        "connector.create",
        "connector.delete",
        "connector.read",
        "knowledge.declassify",
        "knowledge.propose",
        "knowledge.read",
        "migration.approve",
        "migration.execute",
        "obligation.read",
        "obligation.satisfy",
        "obligation.waive",
        "policy.manage",
        "policy.read",
        "proposal.approve",
        "proposal.edit",
        "proposal.read",
        "proposal.reject",
        "proposal.review",
        "semantic_executor.configure",
        "semantic_executor.qualify",
        "semantic_executor.read",
        "source.manage",
        "source.read",
        "source.sync",
        "workspace.configure",
        "workspace.manage_members",
        "workspace.read"
      ]
    },
    "decision": {
      "enum": ["allow", "deny", "insufficient_context"]
    },
    "policyInput": {
      "enum": ["allow", "deny", "insufficient_context", "not_applicable"]
    },
    "principal": {
      "type": "object",
      "required": ["id", "type", "freshness"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "type": { "enum": ["human", "service", "agent", "workload"] },
        "freshness": { "enum": ["current", "expired", "insufficient_context"] }
      }
    },
    "sourceResource": {
      "description": "Repository, project, space, or channel level within a scope.",
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["repository", "project", "space", "channel"] },
        "id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["workspace_id"],
      "additionalProperties": false,
      "properties": {
        "workspace_id": { "$ref": "#/$defs/nonEmpty" },
        "connector_id": { "$ref": "#/$defs/nonEmpty" },
        "source_container_id": { "$ref": "#/$defs/nonEmpty" },
        "resource": { "$ref": "#/$defs/sourceResource" },
        "knowledge_kind": { "$ref": "#/$defs/nonEmpty" },
        "object_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "role": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "grant": {
      "type": "object",
      "required": ["grant_id", "source", "effect", "permission", "scope"],
      "additionalProperties": false,
      "properties": {
        "grant_id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "enum": ["role_assignment", "direct_grant"] },
        "effect": { "enum": ["allow", "deny"] },
        "permission": { "$ref": "#/$defs/permission" },
        "scope": { "$ref": "#/$defs/scope" },
        "expires_at": {
          "description": "Optional expiry for a role assignment and required expiry for every direct grant, regardless of effect. The schema pins the lexical RFC 3339 shape; calendar validity and instant comparison are evaluator-owned and fail closed.",
          "$ref": "#/$defs/rfc3339Timestamp"
        },
        "exceptional_reason": {
          "description": "Required for every human direct grant, regardless of effect.",
          "$ref": "#/$defs/nonEmpty"
        },
        "role": { "$ref": "#/$defs/role" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "direct_grant" } },
            "required": ["source"]
          },
          "then": {
            "required": ["expires_at"],
            "not": { "required": ["role"] }
          },
          "else": {
            "required": ["role"],
            "not": { "required": ["exceptional_reason"] }
          }
        }
      ]
    },
    "sourceAclCeiling": {
      "type": "object",
      "required": ["required", "result"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "result": { "$ref": "#/$defs/policyInput" },
        "snapshot_id": { "$ref": "#/$defs/nonEmpty" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "required": { "const": false } },
            "required": ["required"]
          },
          "then": { "properties": { "result": { "const": "not_applicable" } } },
          "else": {
            "properties": {
              "result": { "enum": ["allow", "deny", "insufficient_context"] }
            }
          }
        },
        {
          "if": {
            "properties": { "result": { "enum": ["allow", "deny"] } },
            "required": ["result"]
          },
          "then": { "required": ["snapshot_id"] }
        }
      ]
    },
    "basis": {
      "description": "Denormalized winning-grant summary emitted by the trusted evaluator for audit display. Replay resolves grant_id against grants and recomputes the decision from the complete recorded inputs.",
      "type": "object",
      "required": ["grant_id", "source", "effect", "scope_match"],
      "additionalProperties": false,
      "properties": {
        "grant_id": { "$ref": "#/$defs/nonEmpty" },
        "source": { "enum": ["role_assignment", "direct_grant"] },
        "effect": { "enum": ["allow", "deny"] },
        "scope_match": { "$ref": "#/$defs/scope" },
        "role": { "$ref": "#/$defs/role" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "direct_grant" } },
            "required": ["source"]
          },
          "then": { "not": { "required": ["role"] } },
          "else": { "required": ["role"] }
        }
      ]
    }
  }
}
