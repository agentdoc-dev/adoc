{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_source_target_receipt.v0.schema.json",
  "title": "agentdoc.cloud.migration_source_target_receipt.v0",
  "description": "Immutable native authorized source mapping and repository metadata snapshot. SHA256 of exact canonical JSON plus LF receipt bytes is the external target digest. Opaque migration source labels are not provider repository identifiers; private paths and credentials are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "migration_id",
    "repository_id",
    "ref",
    "deployment_mode",
    "deployment_binding_digest",
    "helper_digest",
    "workspace_id",
    "provider",
    "external_repository_id",
    "owner",
    "name",
    "connector_id",
    "scope",
    "source_request_id",
    "request_digest",
    "job_digest",
    "initial_revision",
    "command_digest",
    "principal_id",
    "auth_session_id",
    "authorization_decision_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_source_target_receipt.v0"
    },
    "migration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "ref": {
      "description": "Restricted branch-ref grammar for this contract; it does not claim to accept every valid Git ref.",
      "type": "string",
      "minLength": 12,
      "maxLength": 211,
      "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9_-]*(?:/[A-Za-z0-9][A-Za-z0-9_-]*)*$"
    },
    "deployment_mode": {
      "enum": [
        "github_https",
        "local_bare"
      ]
    },
    "deployment_binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "helper_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "external_repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "connector_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "connector_id",
        "source_container_id",
        "resource"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "connector_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_container_id": {
          "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/source_id"
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "repository"
            },
            "id": {
              "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/repository_identity"
            }
          }
        }
      }
    },
    "source_request_id": {
      "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/request_id"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "job_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "initial_revision": {
      "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/revision/properties/value"
    },
    "command_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "auth_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authorization_decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "description": "Native receipt recording time; represents an RFC3339 instant.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "minLength": 20,
      "maxLength": 40
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment_mode": {
            "const": "github_https"
          }
        },
        "required": [
          "deployment_mode"
        ]
      },
      "then": {
        "properties": {
          "provider": {
            "const": "github"
          },
          "owner": {
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "pattern": "^[A-Za-z0-9_.-]+$",
            "not": {
              "enum": [
                ".",
                ".."
              ]
            }
          }
        }
      }
    }
  ]
}
