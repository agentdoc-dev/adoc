{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.semantic_context.v0.schema.json",
  "title": "AgentDoc Semantic Context",
  "description": "Digest-bound semantic context with exact revisions and closed citation handles (E3.1). JSON Schema is preflight only; adoc-core enforces canonical ordering, digest integrity, identity grammar, and semantic completeness.",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_date",
    "subject_revision",
    "source_revision",
    "base_revision",
    "head_revision",
    "basis",
    "selection",
    "capability_policy",
    "context_classes",
    "items",
    "unavailability",
    "coverage",
    "outcome",
    "context_digest"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.semantic_context.v0" },
    "evaluation_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "subject_revision": { "$ref": "#/$defs/exactRevision" },
    "source_revision": { "$ref": "#/$defs/exactRevision" },
    "base_revision": { "$ref": "#/$defs/exactRevision" },
    "head_revision": { "$ref": "#/$defs/exactRevision" },
    "basis": {
      "type": "object",
      "required": ["assessment_digest", "knowledge_basis"],
      "additionalProperties": false,
      "properties": {
        "assessment_digest": { "$ref": "#/$defs/sha256" },
        "knowledge_basis": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "digest"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "graph_artifact" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "digest"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "managed_revision" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["algorithm", "version", "authorized_scope"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "authorized_scope": {
          "description": "Complete trusted scope set considered by selection; multiple scope references are supported and duplicates are invalid.",
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "capability_policy": {
      "type": "object",
      "description": "Closed reason-to-outcome policy. A failed-mapped reason makes the whole semantic context failed even when its context class is optional; optionality suppresses only insufficient outcomes.",
      "required": ["version", "rules"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "rules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["reason", "outcome"],
            "additionalProperties": false,
            "properties": {
              "reason": { "$ref": "#/$defs/unavailabilityReason" },
              "outcome": { "enum": ["insufficient", "failed"] }
            }
          }
        }
      }
    },
    "context_classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_id", "requirement", "byte_budget"],
        "additionalProperties": false,
        "properties": {
          "class_id": { "$ref": "#/$defs/nonEmpty" },
          "requirement": { "$ref": "#/$defs/requirement" },
          "byte_budget": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "description": "Closed citations whose context class, scope, and content are validated against the caller-supplied projection. In local graph receipt mode, every projected Object ID has an explicit trusted class/scope mapping; knowledge_object content is exactly {\"body\": <Graph Knowledge Object body>}, source_binding content is the exact serialized GraphSourceBinding object, and evidence content is the exact serialized evidence entry at evidence_index. Diff-hunk and Source Assertion content comes from the upstream Source Record projection. A truncated item validates only when its projection explicitly permits that truncated content digest.",
      "items": {
        "type": "object",
        "required": ["handle_id", "class_id", "scope_ref", "handle", "content", "truncated"],
        "additionalProperties": false,
        "properties": {
          "handle_id": { "$ref": "#/$defs/nonEmpty" },
          "class_id": { "$ref": "#/$defs/nonEmpty" },
          "scope_ref": { "$ref": "#/$defs/nonEmpty" },
          "handle": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "object_id", "semantic_hash"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "knowledge_object" },
                  "object_id": { "$ref": "#/$defs/objectId" },
                  "semantic_hash": { "$ref": "#/$defs/sha256" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "changed_source_id", "hunk_digest"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "diff_hunk" },
                  "changed_source_id": { "$ref": "#/$defs/nonEmpty" },
                  "hunk_digest": { "$ref": "#/$defs/sha256" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "source_assertion_id", "source_record_id"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "source_assertion" },
                  "source_assertion_id": { "$ref": "#/$defs/nonEmpty" },
                  "source_record_id": { "$ref": "#/$defs/nonEmpty" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "object_id"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "source_binding" },
                  "object_id": { "$ref": "#/$defs/objectId" }
                }
              },
              {
                "type": "object",
                "required": ["kind", "object_id", "evidence_index"],
                "additionalProperties": false,
                "properties": {
                  "kind": { "const": "evidence" },
                  "object_id": { "$ref": "#/$defs/objectId" },
                  "evidence_index": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          },
          "content": {},
          "truncated": { "type": "boolean" }
        }
      }
    },
    "unavailability": {
      "description": "Content-free redaction and omission records; sensitive content and source identifiers are never carried here.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "class_id", "kind", "reason"],
        "additionalProperties": false,
        "properties": {
          "record_id": { "$ref": "#/$defs/nonEmpty" },
          "class_id": { "$ref": "#/$defs/nonEmpty" },
          "kind": { "enum": ["redaction", "omission"] },
          "reason": { "$ref": "#/$defs/unavailabilityReason" }
        }
      }
    },
    "coverage": {
      "description": "Validator-derived coverage diagnostics in context-class order.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class_id",
          "requirement",
          "item_count",
          "included_bytes",
          "byte_budget",
          "truncated",
          "unavailable_count",
          "reasons",
          "complete"
        ],
        "additionalProperties": false,
        "properties": {
          "class_id": { "$ref": "#/$defs/nonEmpty" },
          "requirement": { "$ref": "#/$defs/requirement" },
          "item_count": { "type": "integer", "minimum": 0 },
          "included_bytes": { "type": "integer", "minimum": 0 },
          "byte_budget": { "type": "integer", "minimum": 1 },
          "truncated": { "type": "boolean" },
          "unavailable_count": { "type": "integer", "minimum": 0 },
          "reasons": {
            "type": "array",
            "items": { "$ref": "#/$defs/unavailabilityReason" }
          },
          "complete": { "type": "boolean" }
        }
      }
    },
    "outcome": { "enum": ["ready", "insufficient", "failed"] },
    "context_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "requirement": { "enum": ["required", "optional"] },
    "unavailabilityReason": {
      "enum": ["permission", "retention", "source_outage", "truncation", "resource_limit"]
    },
    "objectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "exactRevision": {
      "type": "object",
      "required": ["system", "value"],
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/$defs/nonEmpty" },
        "value": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
