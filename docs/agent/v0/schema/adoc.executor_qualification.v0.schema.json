{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.executor_qualification.v0.schema.json",
  "title": "AgentDoc Executor Qualification v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "capability",
    "subject",
    "protocol",
    "agentdoc_evaluation",
    "organization_approval",
    "runtime_policy"
  ],
  "properties": {
    "schema_version": { "const": "adoc.executor_qualification.v0" },
    "qualification_id": { "$ref": "#/$defs/text" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "subject": {
      "oneOf": [
        { "$ref": "#/$defs/model_subject" },
        { "$ref": "#/$defs/human_subject" }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "version"],
      "properties": {
        "valid": { "type": "boolean" },
        "version": { "$ref": "#/$defs/text" }
      }
    },
    "agentdoc_evaluation": {
      "oneOf": [
        { "$ref": "#/$defs/capability_evaluation" },
        { "$ref": "#/$defs/human_evaluation" }
      ]
    },
    "organization_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "scope", "risk", "deployment", "policy_digest"],
      "properties": {
        "approved": { "type": "boolean" },
        "scope": { "$ref": "#/$defs/text_set" },
        "risk": { "$ref": "#/$defs/text_set" },
        "deployment": { "$ref": "#/$defs/text_set" },
        "policy_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "operation_digest", "policy_digest"],
      "properties": {
        "eligible": { "type": "boolean" },
        "operation_digest": { "$ref": "#/$defs/digest" },
        "policy_digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "text_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "model_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "executor_digest",
        "model_digest",
        "config_digest",
        "configuration"
      ],
      "properties": {
        "kind": { "const": "model" },
        "provider": { "$ref": "#/$defs/text" },
        "executor_digest": { "$ref": "#/$defs/digest" },
        "model_digest": { "$ref": "#/$defs/digest" },
        "config_digest": { "$ref": "#/$defs/digest" },
        "configuration": { "$ref": "#/$defs/model_configuration" }
      }
    },
    "model_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_revision_digest",
        "quantization_digest",
        "system_prompt_task_digest",
        "context_strategy_digest",
        "output_constraints_digest",
        "toolset_digest",
        "inference_parameters_digest",
        "safety_configuration_digest",
        "adapter_implementation_digest"
      ],
      "properties": {
        "model_revision_digest": { "$ref": "#/$defs/digest" },
        "quantization_digest": { "$ref": "#/$defs/digest" },
        "system_prompt_task_digest": { "$ref": "#/$defs/digest" },
        "context_strategy_digest": { "$ref": "#/$defs/digest" },
        "output_constraints_digest": { "$ref": "#/$defs/digest" },
        "toolset_digest": { "$ref": "#/$defs/digest" },
        "inference_parameters_digest": { "$ref": "#/$defs/digest" },
        "safety_configuration_digest": { "$ref": "#/$defs/digest" },
        "adapter_implementation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "human_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "principal_id",
        "executor_digest",
        "config_digest",
        "permission_policy_digest"
      ],
      "properties": {
        "kind": { "const": "human" },
        "principal_id": { "$ref": "#/$defs/text" },
        "executor_digest": { "$ref": "#/$defs/digest" },
        "config_digest": { "$ref": "#/$defs/digest" },
        "permission_policy_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "capability_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "qualified", "evidence_ref"],
      "properties": {
        "kind": { "const": "capability" },
        "qualified": { "type": "boolean" },
        "evidence_ref": { "$ref": "#/$defs/text" }
      }
    },
    "human_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "qualified", "principal_id", "permission_policy_digest"],
      "properties": {
        "kind": { "const": "authenticated_permission" },
        "qualified": { "type": "boolean" },
        "principal_id": { "$ref": "#/$defs/text" },
        "permission_policy_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
