{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.sensitive_access.v1.schema.json",
  "title": "Gateway-Reported Sensitive Access Event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "context",
    "caller",
    "reporting_basis",
    "command",
    "local_policy_digest",
    "sequence",
    "objects"
  ],
  "properties": {
    "schema_version": {
      "const": "adoc.sensitive_access.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "context": {
      "type": "object",
      "required": [
        "kind",
        "workspace_id",
        "repository_id"
      ],
      "properties": {
        "kind": {
          "const": "gateway_repository"
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "caller": {
      "type": "object",
      "required": [
        "principal_id",
        "auth_session_id",
        "gateway_session_id"
      ],
      "properties": {
        "principal_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "auth_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "gateway_session_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "command": {
      "enum": [
        "search",
        "why",
        "graph",
        "stale",
        "contradictions",
        "impacted_by"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Strict Object ID ascending order, unique object IDs; domain validator enforces cross-item order and exact event byte limit. Only actually exposed sensitive subjects.",
      "items": {
        "type": "object",
        "required": [
          "object_id",
          "content_hash",
          "classification"
        ],
        "properties": {
          "object_id": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "classification": {
            "enum": [
              "internal",
              "restricted"
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    },
    "reporting_basis": {
      "const": "gateway_reported"
    },
    "local_policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "description": "Gateway-reported repository subjects; validity grants no native managed authority. Exact serialized UTF-8 event is bounded to 1 MiB by the domain validator."
}
