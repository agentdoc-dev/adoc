{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.semantic_executor_request.v0.schema.json",
  "title": "AgentDoc Semantic Executor Request",
  "description": "Provider-neutral request for Claude, Codex, generic/customer-hosted, local, and human adapters. adoc-core validates nested semantic context integrity and all digest bindings.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "capability",
    "adapter",
    "task_digest",
    "prompt",
    "timeout_seconds",
    "context"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.semantic_executor_request.v0" },
    "request_id": { "$ref": "#/$defs/nonEmpty" },
    "capability": { "$ref": "#/$defs/nonEmpty" },
    "adapter": {
      "type": "object",
      "required": [
        "kind",
        "provider",
        "model",
        "endpoint_class",
        "endpoint_id",
        "executor_digest",
        "model_digest",
        "config_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["claude_code", "codex", "generic", "human"] },
        "provider": { "$ref": "#/$defs/nonEmpty" },
        "model": { "$ref": "#/$defs/nonEmpty" },
        "endpoint_class": { "enum": ["public_provider", "customer_hosted", "local", "human"] },
        "endpoint_id": { "$ref": "#/$defs/nonEmpty" },
        "executor_digest": { "$ref": "#/$defs/sha256" },
        "model_digest": { "$ref": "#/$defs/sha256" },
        "config_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "task_digest": { "$ref": "#/$defs/sha256" },
    "prompt": {
      "type": "object",
      "required": ["contract_version", "digest", "instructions"],
      "additionalProperties": false,
      "properties": {
        "contract_version": { "$ref": "#/$defs/nonEmpty" },
        "digest": {
          "allOf": [{ "$ref": "#/$defs/sha256" }],
          "description": "SHA-256 of compact canonical JSON containing exactly contract_version and instructions."
        },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 262144 }
      }
    },
    "timeout_seconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
    "context": { "$ref": "#/$defs/semanticContext" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "properties": { "kind": { "const": "human" } },
            "required": ["kind"]
          }
        },
        "required": ["adapter"]
      },
      "then": {
        "properties": {
          "adapter": {
            "properties": { "endpoint_class": { "const": "human" } }
          }
        }
      },
      "else": {
        "properties": {
          "adapter": {
            "properties": { "endpoint_class": { "not": { "const": "human" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "unavailabilityReason": {
      "enum": ["permission", "retention", "source_outage", "truncation", "resource_limit"]
    },
    "objectId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "exactRevision": {
      "type": "object",
      "required": ["system", "value"],
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/$defs/nonEmpty" },
        "value": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "basis": {
      "type": "object",
      "required": ["assessment_digest", "knowledge_basis"],
      "additionalProperties": false,
      "properties": {
        "assessment_digest": { "$ref": "#/$defs/sha256" },
        "knowledge_basis": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "digest"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "graph_artifact" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "digest"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "managed_revision" },
                "digest": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "required": ["algorithm", "version", "authorized_scope"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "$ref": "#/$defs/nonEmpty" },
        "version": { "$ref": "#/$defs/nonEmpty" },
        "authorized_scope": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "capabilityPolicy": {
      "type": "object",
      "required": ["version", "rules"],
      "additionalProperties": false,
      "properties": {
        "version": { "$ref": "#/$defs/nonEmpty" },
        "rules": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["reason", "outcome"],
            "additionalProperties": false,
            "properties": {
              "reason": { "$ref": "#/$defs/unavailabilityReason" },
              "outcome": { "enum": ["insufficient", "failed"] }
            }
          }
        }
      }
    },
    "contextClass": {
      "type": "object",
      "required": ["class_id", "requirement", "byte_budget"],
      "additionalProperties": false,
      "properties": {
        "class_id": { "$ref": "#/$defs/nonEmpty" },
        "requirement": { "enum": ["required", "optional"] },
        "byte_budget": { "type": "integer", "minimum": 1 }
      }
    },
    "citationHandle": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "object_id", "semantic_hash"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "knowledge_object" },
            "object_id": { "$ref": "#/$defs/objectId" },
            "semantic_hash": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "changed_source_id", "hunk_digest"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "diff_hunk" },
            "changed_source_id": { "$ref": "#/$defs/nonEmpty" },
            "hunk_digest": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "source_assertion_id", "source_record_id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "source_assertion" },
            "source_assertion_id": { "$ref": "#/$defs/nonEmpty" },
            "source_record_id": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "object_id"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "source_binding" },
            "object_id": { "$ref": "#/$defs/objectId" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "object_id", "evidence_index"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "evidence" },
            "object_id": { "$ref": "#/$defs/objectId" },
            "evidence_index": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "contextItem": {
      "type": "object",
      "required": ["handle_id", "class_id", "scope_ref", "handle", "content", "truncated"],
      "additionalProperties": false,
      "properties": {
        "handle_id": { "$ref": "#/$defs/nonEmpty" },
        "class_id": { "$ref": "#/$defs/nonEmpty" },
        "scope_ref": { "$ref": "#/$defs/nonEmpty" },
        "handle": { "$ref": "#/$defs/citationHandle" },
        "content": {},
        "truncated": { "type": "boolean" }
      }
    },
    "unavailability": {
      "type": "object",
      "required": ["record_id", "class_id", "kind", "reason"],
      "additionalProperties": false,
      "properties": {
        "record_id": { "$ref": "#/$defs/nonEmpty" },
        "class_id": { "$ref": "#/$defs/nonEmpty" },
        "kind": { "enum": ["redaction", "omission"] },
        "reason": { "$ref": "#/$defs/unavailabilityReason" }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "class_id",
        "requirement",
        "item_count",
        "included_bytes",
        "byte_budget",
        "truncated",
        "unavailable_count",
        "reasons",
        "complete"
      ],
      "additionalProperties": false,
      "properties": {
        "class_id": { "$ref": "#/$defs/nonEmpty" },
        "requirement": { "enum": ["required", "optional"] },
        "item_count": { "type": "integer", "minimum": 0 },
        "included_bytes": { "type": "integer", "minimum": 0 },
        "byte_budget": { "type": "integer", "minimum": 1 },
        "truncated": { "type": "boolean" },
        "unavailable_count": { "type": "integer", "minimum": 0 },
        "reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/unavailabilityReason" }
        },
        "complete": { "type": "boolean" }
      }
    },
    "semanticContext": {
      "type": "object",
      "required": [
        "schema_version",
        "evaluation_date",
        "subject_revision",
        "source_revision",
        "base_revision",
        "head_revision",
        "basis",
        "selection",
        "capability_policy",
        "context_classes",
        "items",
        "unavailability",
        "coverage",
        "outcome",
        "context_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "adoc.semantic_context.v0" },
        "evaluation_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "subject_revision": { "$ref": "#/$defs/exactRevision" },
        "source_revision": { "$ref": "#/$defs/exactRevision" },
        "base_revision": { "$ref": "#/$defs/exactRevision" },
        "head_revision": { "$ref": "#/$defs/exactRevision" },
        "basis": { "$ref": "#/$defs/basis" },
        "selection": { "$ref": "#/$defs/selection" },
        "capability_policy": { "$ref": "#/$defs/capabilityPolicy" },
        "context_classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextClass" }
        },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/contextItem" },
          "contains": {
            "type": "object",
            "required": ["handle"],
            "properties": {
              "handle": {
                "type": "object",
                "required": ["kind"],
                "properties": { "kind": { "const": "diff_hunk" } }
              }
            }
          },
          "minContains": 1
        },
        "unavailability": {
          "type": "array",
          "items": { "$ref": "#/$defs/unavailability" }
        },
        "coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverage" }
        },
        "outcome": { "enum": ["ready", "insufficient", "failed"] },
        "context_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
