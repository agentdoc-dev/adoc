{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.repository_inspection_request.v0.schema.json",
  "title": "AgentDoc Repository Inspection Request",
  "description": "Read-only exact-commit inspection input bound to workspace, provider repository, ref, full nonzero lowercase Git SHA-1, explicit evaluation date and exact runtime pin. Domain validation remains authoritative. At most 16384 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "provider_repository_id",
    "ref",
    "git_revision",
    "evaluation_date",
    "runtime"
  ],
  "properties": {
    "schema_version": {
      "const": "adoc.repository_inspection_request.v0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "provider_repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "const": "0000000000000000000000000000000000000000"
      }
    },
    "evaluation_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "binary_digest"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
        },
        "binary_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
