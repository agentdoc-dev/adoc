{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_source_checkpoint_receipt.v0.schema.json",
  "title": "agentdoc.cloud.migration_source_checkpoint_receipt.v0",
  "description": "Native comparison of an actual worker-reported source observation to the prepared revision, bound to an exact intended operation. Match is comparison evidence, not operation approval, execution, readiness or atomic cutover. Admitted drift or unavailable permanently stops new successful work for the enrolled job; a later match cannot clear it. Exact canonical JSON plus LF bytes define the receipt digest. The stop is derived from the existence of any admitted negative for the migration, regardless of receipt order; a match does not report job health. Worker attribution uses principal_id and authorization_decision_id rather than an interactive human auth_session_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "migration_id",
    "observation_id",
    "target_digest",
    "command_digest",
    "operation",
    "expected",
    "compared_revision",
    "observed_oid",
    "observed_at",
    "helper_digest",
    "outcome",
    "principal_id",
    "authorization_decision_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_source_checkpoint_receipt.v0"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "migration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "target_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "command_digest": {
      "description": "Digest of this admitted checkpoint command, distinct from operation.command_digest for the intended lifecycle operation.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operation": {
      "description": "Exact intended lifecycle operation; its command_digest identifies that operation command, not this checkpoint command.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "command_digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "advance",
            "initialize"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "command_digest": {
          "description": "Digest of the intended operation command.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "expected": {
      "$ref": "adoc://agent/v0/schema/agentdoc.cloud.migration_transition_request.v0.schema.json#/properties/expected"
    },
    "compared_revision": {
      "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/revision/properties/value"
    },
    "observed_oid": {
      "anyOf": [
        {
          "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/revision/properties/value"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "description": "Observation time. Compare RFC3339 instants, not lexical timestamp strings; zone and trailing-fraction normalization are allowed.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "minLength": 20,
      "maxLength": 40
    },
    "helper_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "enum": [
        "match",
        "drift",
        "unavailable"
      ]
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authorization_decision_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "recorded_at": {
      "description": "Native receipt recording time; represents an RFC3339 instant.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "minLength": 20,
      "maxLength": 40
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "unavailable"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "observed_oid": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "observed_oid": {
            "$ref": "adoc://agent/v0/schema/adoc.migration_request.v0.schema.json#/properties/revision/properties/value"
          }
        }
      }
    }
  ]
}
