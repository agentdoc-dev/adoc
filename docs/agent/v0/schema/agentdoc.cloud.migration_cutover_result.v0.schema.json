{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"adoc://agent/v0/schema/agentdoc.cloud.migration_cutover_result.v0.schema.json","title":"agentdoc.cloud.migration_cutover_result.v0","description":"Closed transport returning exact stored receipt bytes and SHA256 digest. Concrete receipt schemas discriminate the bytes; no parsed duplicate is authoritative.","type":"object","additionalProperties":false,"required":["schema_version","receipt_bytes_base64","receipt_digest"],"properties":{"schema_version":{"const":"agentdoc.cloud.migration_cutover_result.v0"},"receipt_bytes_base64":{"type":"string","minLength":4,"maxLength":699052,"pattern":"^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"},"receipt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
