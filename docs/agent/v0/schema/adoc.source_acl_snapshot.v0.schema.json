{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.source_acl_snapshot.v0.schema.json",
  "title": "AgentDoc Historical Source ACL Snapshot",
  "description": "Immutable historical ACL provenance retained with source-derived assertions. This envelope is never current authorization evidence: freshness, expiry, connector availability, and effective access are evaluated separately by Cloud under the connector ACL policy.",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "connector_id",
    "acl_policy_version",
    "source",
    "observed_at",
    "acl_payload_digest",
    "usage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.source_acl_snapshot.v0" },
    "snapshot_id": { "$ref": "#/$defs/nonEmpty" },
    "connector_id": { "$ref": "#/$defs/nonEmpty" },
    "acl_policy_version": {
      "description": "Connector ACL policy version active when this historical snapshot was observed.",
      "$ref": "#/$defs/nonEmpty"
    },
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["repository", "project", "space", "channel"] },
        "id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "observed_at": {
      "description": "Observation instant. The schema pins the lexical RFC 3339 shape; calendar validity and instant comparison are evaluator-owned and fail closed.",
      "$ref": "#/$defs/rfc3339Timestamp"
    },
    "acl_payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usage": { "const": "historical_provenance" }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "pattern": "^\\S(?:[^\\r\\n\\u2028\\u2029]*\\S)?$"
    },
    "rfc3339Timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:(?:[0-5]\\d|60)(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
    }
  }
}
