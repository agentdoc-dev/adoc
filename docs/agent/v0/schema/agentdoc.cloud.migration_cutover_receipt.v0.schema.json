{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_cutover_receipt.v0.schema.json",
  "title": "agentdoc.cloud.migration_cutover_receipt.v0",
  "description": "Closed immutable final cutover receipt. effective_prior_policy_receipt_digest is the inherited rollback basis; prior_exact_scope_policy_receipt_digest is separately retained and nullable. Neither is a self-referential receipt digest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workspace_id",
    "migration_id",
    "transition_id",
    "command_digest",
    "readiness_receipt_digest",
    "source_target_digest",
    "fence_receipt_digest",
    "initialization_id",
    "initialization_attestation_digest",
    "initial_revision",
    "scope",
    "effective_prior_policy_receipt_digest",
    "prior_exact_scope_policy_receipt_digest",
    "committed_policy_receipt_digest",
    "managed_frontier",
    "managed_frontier_digest",
    "principal_id",
    "auth_session_id",
    "migration_authorization_decision_id",
    "connector_authorization_decision_id",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_cutover_receipt.v0"
    },
    "workspace_id": {
      "$ref": "#/$defs/uuid"
    },
    "migration_id": {
      "$ref": "#/$defs/uuid"
    },
    "transition_id": {
      "$ref": "#/$defs/uuid"
    },
    "command_digest": {
      "$ref": "#/$defs/digest"
    },
    "readiness_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_target_digest": {
      "$ref": "#/$defs/digest"
    },
    "fence_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "initialization_id": {
      "$ref": "#/$defs/uuid"
    },
    "initialization_attestation_digest": {
      "$ref": "#/$defs/digest"
    },
    "initial_revision": {
      "$ref": "#/$defs/oid"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "effective_prior_policy_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "prior_exact_scope_policy_receipt_digest": {
      "anyOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "committed_policy_receipt_digest": {
      "$ref": "#/$defs/digest"
    },
    "managed_frontier": {
      "type": "array",
      "maxItems": 65536,
      "items": {
        "$ref": "#/$defs/frontier"
      }
    },
    "managed_frontier_digest": {
      "$ref": "#/$defs/digest"
    },
    "principal_id": {
      "$ref": "#/$defs/uuid"
    },
    "auth_session_id": {
      "$ref": "#/$defs/uuid"
    },
    "migration_authorization_decision_id": {
      "$ref": "#/$defs/uuid"
    },
    "connector_authorization_decision_id": {
      "$ref": "#/$defs/uuid"
    },
    "recorded_at": {
      "$ref": "#/$defs/time"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "oid": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "not": {
        "const": "0000000000000000000000000000000000000000"
      }
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "scope": {
      "$ref": "adoc://agent/v0/schema/agentdoc.cloud.migration_transition_receipt.v0.schema.json#/properties/scope"
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_id",
        "canonical_id",
        "initialized_version_id",
        "content_hash",
        "content_digest",
        "active_version_id",
        "active_promotion_seq",
        "latest_promotion_seq",
        "latest_state_event_seq",
        "latest_state_event_digest",
        "latest_effectivity_policy_seq"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "canonical_id": {
          "$ref": "#/$defs/uuid"
        },
        "initialized_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "content_hash": {
          "$ref": "#/$defs/digest"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "active_version_id": {
          "$ref": "#/$defs/uuid"
        },
        "active_promotion_seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "latest_promotion_seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "latest_state_event_seq": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "latest_state_event_digest": {
          "$ref": "#/$defs/digest"
        },
        "latest_effectivity_policy_seq": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
