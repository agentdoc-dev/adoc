{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.migration_request.v1.schema.json",
  "title": "AgentDoc Exact Revision Migration Request v1",
  "description": "Successor of adoc.migration_request.v0 adding the selected starting point and the trusted repository inspection binding. recorded_history keeps v0 semantics; fresh makes every eligible item a review-required candidate and never adopts authored history as approval. Unknown versions or fields fail closed. Portable preparation input; exact-match version and full nonzero lowercase Git SHA-1. Domain validation remains authoritative. At most 16384 UTF-8 bytes. Identity fields are at most 1024 UTF-8 bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "workspace_id",
    "source_id",
    "repository_identity",
    "revision",
    "evaluation_date",
    "inspection_id",
    "inspection_digest",
    "starting_point"
  ],
  "properties": {
    "schema_version": {
      "const": "adoc.migration_request.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "repository_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "value"
      ],
      "properties": {
        "system": {
          "const": "git"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "not": {
            "const": "0000000000000000000000000000000000000000"
          }
        }
      }
    },
    "evaluation_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "inspection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S(?:[^\\u0000-\\u001f\\u007f-\\u009f]*\\S)?$"
    },
    "inspection_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "starting_point": {
      "enum": [
        "recorded_history",
        "fresh"
      ]
    }
  }
}
