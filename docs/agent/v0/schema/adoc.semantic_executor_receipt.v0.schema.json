{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.semantic_executor_receipt.v0.schema.json",
  "title": "AgentDoc Semantic Executor Receipt",
  "description": "Deterministic adapter receipt binding provider/model identity and exact executor, model, configuration, task, prompt, context, request, and validated assessment digests.",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "request_digest",
    "capability",
    "adapter",
    "task_digest",
    "prompt_digest",
    "context_digest",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.semantic_executor_receipt.v0" },
    "request_id": { "$ref": "#/$defs/nonEmpty" },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "capability": { "$ref": "#/$defs/nonEmpty" },
    "adapter": { "$ref": "#/$defs/adapter" },
    "task_digest": { "$ref": "#/$defs/sha256" },
    "prompt_digest": { "$ref": "#/$defs/sha256" },
    "context_digest": { "$ref": "#/$defs/sha256" },
    "outcome": { "enum": ["completed", "failed"] },
    "assessment_digest": {
      "allOf": [{ "$ref": "#/$defs/sha256" }],
      "description": "SHA-256 of the canonical assessment serialization owned by the authoritative validator."
    },
    "failure_code": { "$ref": "#/$defs/nonEmpty" }
  },
  "oneOf": [
    {
      "required": ["assessment_digest"],
      "not": { "required": ["failure_code"] },
      "properties": { "outcome": { "const": "completed" } }
    },
    {
      "required": ["failure_code"],
      "not": { "required": ["assessment_digest"] },
      "properties": { "outcome": { "const": "failed" } }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "adapter": {
            "properties": { "kind": { "const": "human" } },
            "required": ["kind"]
          }
        },
        "required": ["adapter"]
      },
      "then": {
        "properties": {
          "adapter": {
            "properties": {
              "provider": { "const": "human" },
              "endpoint_class": { "const": "human" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "adapter": {
            "properties": {
              "provider": { "not": { "const": "human" } },
              "endpoint_class": { "not": { "const": "human" } }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "^\\S(?:.*\\S)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "adapter": {
      "type": "object",
      "required": [
        "kind",
        "provider",
        "model",
        "endpoint_class",
        "endpoint_id",
        "executor_digest",
        "model_digest",
        "config_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["claude_code", "codex", "generic", "human"] },
        "provider": { "$ref": "#/$defs/nonEmpty" },
        "model": { "$ref": "#/$defs/nonEmpty" },
        "endpoint_class": { "enum": ["public_provider", "customer_hosted", "local", "human"] },
        "endpoint_id": { "$ref": "#/$defs/nonEmpty" },
        "executor_digest": { "$ref": "#/$defs/sha256" },
        "model_digest": { "$ref": "#/$defs/sha256" },
        "config_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
