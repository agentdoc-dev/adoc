{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_cutover_admission.v0.schema.json",
  "title": "agentdoc.cloud.migration_cutover_admission.v0",
  "description": "Closed 1..131072 UTF-8 byte trusted-server admission assertion, not provider-signed evidence. Native storage verifies retained bytes; admission shape does not authorize cutover.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_id",
    "migration_id",
    "source_target_digest",
    "controller_binding_digest",
    "provider",
    "external_repository_id",
    "inventory",
    "inventory_digest",
    "writer_qualification",
    "control_policy",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "agentdoc.cloud.migration_cutover_admission.v0"
    },
    "admission_id": {
      "$ref": "#/$defs/uuid"
    },
    "migration_id": {
      "$ref": "#/$defs/uuid"
    },
    "source_target_digest": {
      "$ref": "#/$defs/digest"
    },
    "controller_binding_digest": {
      "$ref": "#/$defs/digest"
    },
    "provider": {
      "const": "github"
    },
    "external_repository_id": {
      "$ref": "#/$defs/decimal"
    },
    "inventory": {
      "$ref": "#/$defs/inventory"
    },
    "inventory_digest": {
      "$ref": "#/$defs/digest"
    },
    "writer_qualification": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": { "properties": { "credential_class": { "const": "human_git" } }, "required": ["credential_class"] },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": { "properties": { "credential_class": { "const": "github_installation_token" } }, "required": ["credential_class"] },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": { "properties": { "credential_class": { "const": "deploy_key" } }, "required": ["credential_class"] },
          "minContains": 0,
          "maxContains": 1
        }
      ],
      "items": {
        "$ref": "#/$defs/qualification"
      }
    },
    "control_policy": {
      "$ref": "#/$defs/control"
    },
    "observed_at": {
      "$ref": "#/$defs/time"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collaborators",
        "installations",
        "deploy_keys",
        "deploy_keys_policy"
      ],
      "properties": {
        "collaborators": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "role"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/decimal"
              },
              "role": {
                "enum": [
                  "read",
                  "triage",
                  "write",
                  "maintain",
                  "admin"
                ]
              }
            }
          }
        },
        "installations": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "app_id",
              "repository_membership",
              "contents",
              "administration",
              "workflows"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/decimal"
              },
              "app_id": {
                "$ref": "#/$defs/decimal"
              },
              "repository_membership": {
                "description": "potential is a current organization installation whose selected target membership is unasserted; native applies the full permission ceiling and the same capability and classification rules as included.",
                "enum": [
                  "included",
                  "excluded",
                  "potential"
                ]
              },
              "contents": {
                "enum": [
                  "none",
                  "read",
                  "write"
                ]
              },
              "administration": {
                "enum": [
                  "none",
                  "read",
                  "write"
                ]
              },
              "workflows": {
                "enum": [
                  "none",
                  "read",
                  "write"
                ]
              }
            }
          }
        },
        "deploy_keys": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "read_only"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/decimal"
              },
              "read_only": {
                "type": "boolean"
              }
            }
          }
        },
        "deploy_keys_policy": {
          "enum": [
            "enabled",
            "disabled"
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credential_class",
        "baseline",
        "update",
        "force_update",
        "deletion",
        "creation",
        "evidence_digest"
      ],
      "properties": {
        "credential_class": {
          "enum": [
            "human_git",
            "github_installation_token",
            "deploy_key"
          ]
        },
        "baseline": {
          "const": "allowed"
        },
        "update": {
          "const": "GH013"
        },
        "force_update": {
          "const": "GH013"
        },
        "deletion": {
          "const": "GH013"
        },
        "creation": {
          "const": "GH013"
        },
        "evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "trusted_editors",
        "source_workers",
        "qualification_evidence_digest"
      ],
      "properties": {
        "mode": {
          "const": "controller_protocol_only"
        },
        "trusted_editors": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "source_workers": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identity"
          }
        },
        "qualification_evidence_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "identity": {
      "type": "string",
      "pattern": "^(?:user|installation|deploy_key):[1-9][0-9]*$"
    }
  }
}
