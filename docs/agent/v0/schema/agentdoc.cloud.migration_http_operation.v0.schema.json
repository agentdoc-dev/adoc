{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/agentdoc.cloud.migration_http_operation.v0.schema.json",
  "title": "agentdoc.cloud.migration_http_operation.v0",
  "description": "Closed public projection for a queued Cloud migration prepare operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "migration_id", "operation", "status", "status_url"],
  "properties": {
    "schema_version": { "const": "agentdoc.cloud.migration_http_operation.v0" },
    "operation_id": { "$ref": "#/$defs/uuid" },
    "migration_id": { "$ref": "#/$defs/uuid" },
    "operation": { "const": "prepare" },
    "status": { "const": "queued" },
    "status_url": {
      "type": "string",
      "pattern": "^/api/v1/workspaces/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/migrations/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\\?operation_id=[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
