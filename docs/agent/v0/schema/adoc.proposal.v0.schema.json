{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adoc://agent/v0/schema/adoc.proposal.v0.schema.json",
  "title": "AgentDoc Canonical Proposal Record",
  "description": "E5.1 canonical proposal record (ADR-0062). Binds a validated adoc.patch.v0 set to exact source revisions, deterministic assessment, semantic context, semantic assessment, and the exact content_hash of every edited Knowledge Object. Identity is the proposal-set digest over the exact patch bytes ordered by patch digest alone (ADR-0062 §2, superseding ADR-0053 §8 in part); `supersedes` names the prior digest an edit replaces. The record carries no branch names, titles, or wall-clock fields. JSON Schema is transport preflight only; adoc-core re-derives every digest and ordering.",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_set_digest",
    "supersedes",
    "bindings",
    "content_bindings",
    "patches"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "adoc.proposal.v0" },
    "proposal_set_digest": { "$ref": "#/$defs/digest" },
    "supersedes": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/digest" }] },
    "bindings": {
      "type": "object",
      "required": [
        "base_revision",
        "head_revision",
        "change_request",
        "assessment_digest",
        "semantic_context_digest",
        "semantic_assessment_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "base_revision": { "$ref": "#/$defs/revision" },
        "head_revision": { "$ref": "#/$defs/revision" },
        "change_request": {
          "type": "object",
          "description": "Change-request identity by system and identifier, never by branch name or title.",
          "required": ["system", "id"],
          "additionalProperties": false,
          "properties": {
            "system": { "$ref": "#/$defs/text" },
            "id": { "$ref": "#/$defs/text" }
          }
        },
        "assessment_digest": { "$ref": "#/$defs/digest" },
        "semantic_context_digest": { "$ref": "#/$defs/digest" },
        "semantic_assessment_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "content_bindings": {
      "type": "array",
      "description": "Exact-head content_hash of every existing Knowledge Object the proposal edits, sorted by object_id — for a two-patch logical update the hash the update_fields patch binds, not the re-derived hash the replace_body patch binds; a placement-only move leaves them unchanged.",
      "items": {
        "type": "object",
        "required": ["object_id", "content_hash"],
        "additionalProperties": false,
        "properties": {
          "object_id": { "$ref": "#/$defs/object_id" },
          "content_hash": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "description": "Sorted by patch_digest alone, so identity is placement-blind; patch_digest covers the sorted compact serialization plus one newline.",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "placement_path",
          "page_id",
          "target",
          "operation",
          "patch_digest",
          "patch"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "$ref": "#/$defs/text" },
          "placement_path": { "$ref": "#/$defs/text" },
          "page_id": { "$ref": "#/$defs/text" },
          "target": { "$ref": "#/$defs/object_id" },
          "operation": { "enum": ["create_object", "update_fields", "replace_body"] },
          "patch_digest": { "$ref": "#/$defs/digest" },
          "patch": {
            "type": "object",
            "description": "The exact adoc.patch.v0 document; patch_digest covers its sorted compact serialization plus one newline.",
            "required": ["schema_version", "op", "target", "changes", "reason", "proposer"],
            "additionalProperties": false,
            "properties": {
              "schema_version": { "const": "adoc.patch.v0" },
              "op": { "enum": ["create_object", "update_fields", "replace_body"] },
              "target": { "$ref": "#/$defs/object_id" },
              "base_hash": { "$ref": "#/$defs/digest" },
              "changes": { "type": "object" },
              "reason": { "$ref": "#/$defs/text" },
              "proposer": {
                "type": "object",
                "required": ["type", "id"],
                "additionalProperties": false,
                "properties": {
                  "type": { "const": "agent" },
                  "id": { "$ref": "#/$defs/text" }
                }
              }
            },
            "oneOf": [
              {
                "required": ["base_hash"],
                "properties": {
                  "op": { "const": "replace_body" },
                  "changes": {
                    "type": "object",
                    "required": ["body"],
                    "properties": { "body": { "type": "string" } },
                    "additionalProperties": false
                  }
                }
              },
              {
                "required": ["base_hash"],
                "properties": {
                  "op": { "const": "update_fields" },
                  "changes": {
                    "type": "object",
                    "required": ["fields"],
                    "properties": {
                      "fields": {
                        "allOf": [
                          { "$ref": "#/$defs/fields" },
                          { "minProperties": 1 }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              {
                "not": { "required": ["base_hash"] },
                "properties": {
                  "op": { "const": "create_object" },
                  "changes": {
                    "type": "object",
                    "required": ["kind", "body"],
                    "properties": {
                      "kind": { "type": "string" },
                      "status": { "type": "string" },
                      "body": { "type": "string" },
                      "fields": { "$ref": "#/$defs/fields" },
                      "placement": { "$ref": "#/$defs/placement" }
                    },
                    "additionalProperties": false
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u0020\\u007f-\\u009f\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u001f\\u0020\\u007f-\\u009f\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?$"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fields": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "placement": {
      "type": "object",
      "required": ["page_id"],
      "properties": {
        "page_id": { "type": "string" },
        "after": { "type": "string" }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": ["system", "value"],
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/$defs/text" },
        "value": { "$ref": "#/$defs/text" }
      }
    }
  }
}
